# Copy to your runtime env for the Airflow container
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crypto
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# For dbt (Airflow BashOperator uses these)
DBT_HOST=${POSTGRES_HOST}
DBT_PORT=${POSTGRES_PORT}
DBT_DB=${POSTGRES_DB}
DBT_USER=${POSTGRES_USER}
DBT_PASSWORD=${POSTGRES_PASSWORD}

# DAG inputs (can also set as Airflow Variables: CRYPTO_COINS, VS_CURRENCY)
COINS=bitcoin,ethereum,solana,binancecoin
VS_CURRENCY=usd
