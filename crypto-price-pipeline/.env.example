# Copy to your runtime env for the Airflow container
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crypto
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# For dbt (Airflow BashOperator uses these)
DBT_HOST=postgres
DBT_PORT=5432
DBT_DB=crypto
DBT_USER=postgres
DBT_PASSWORD=postgres

# DAG inputs (can also set as Airflow Variables: CRYPTO_COINS, VS_CURRENCY)
COINS=bitcoin,ethereum,solana,binancecoin
VS_CURRENCY=usd
